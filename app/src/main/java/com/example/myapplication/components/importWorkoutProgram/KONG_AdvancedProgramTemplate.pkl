module com.example.myapplication.AdvancedProgramTemplate

class Program {
  name: String
  arthur: String
  shortDescription: String
  description: String
  programLength: String
  uri: String
  level: String
  programEquipment: String
  daysPerWeek: String
  mesocycles: Listing<Mesocycle>
}

class Mesocycle {
  name: String
  description: String
  order: Int
  microcycles: Listing<Microcycle>
}

class Microcycle {
  name: String
  description: String
  order: Int
  workouts: Listing<Workout>
  advancedWorkouts: Listing<AdvancedWorkout>
}

class Workout {
  name: String
  //     workoutArthur: String
  day: Int
  notes: Listing
  exercisesSets: Listing<ExerciseSets>
}

class AdvancedWorkout {
  name: String
  //     workoutArthur: String
  day: Int
  notes: Listing
  exercisesSets: Listing<ExerciseSets>
  advancedExercisesSets: Listing<AdvancedExerciseSets>
}

class ExerciseSets {
  name: String
  notes: Listing
  // Number of sets to be performed
  sets: Int 
  // Target repetitions
  repetitions: Int? = null

  // Normal by default, Listing - length/number of elements must equal number of sets
  setType: String = ""
  targetWeightPounds: Float? = null
  targetWeightKilograms: Float? = null
  weightIncrementPounds: Float? = null
  weightIncrementKilograms: Float? = null
  targetRepetitionsInReserve: Int? = null // Reps in Reserve
  targetRatePerceivedEffort: Int? = null // Rate of Perceived Exertion
  percentage1RM: Float? = null // Percentage of 1 Rep Max

  // TODO Determine Correct Type
  progressionSchemeID: String? = null
  minRepetitions: Int? = null
  maxRepetitions: Int? = null
}

class AdvancedExerciseSets {
  name: String
  notes: Listing
  sets: Int? = null// Number of sets to be performed
  // Normal by default, Listing - length/number of elements must equal number of sets
  setType: String = ""
  repetitions: List<Int>? = null // Target repetitions
  targetRepetitionsInReserve: List<Int>? = null // Reps in Reserve
  targetRatePerceivedEffort: List<Int>? = null // Rate of Perceived Exertion

  targetWeightPounds: List<Float>? = null
  targetWeightKilograms: List<Float>? = null
  
  weightIncrementPounds: Float? = null
  weightIncrementKilograms: Float? = null
  
  percentage1RM: List<Float>? = null // Percentage of 1 Rep Max

  // TODO Determine Correct Type
  progressionSchemeID: String? = null
  minRepetitions: Int? = null //
  maxRepetitions: Int? = null//
  setScheme: SetScheme?
}

class SetScheme {
  sets: Int
  setType: String = "" // Normal by default, Listing - length/number of elements must equal number of sets
  // Target repetitions
  repetitions: List<Int> 
  
  targetWeightPounds: List<Float>
  targetWeightKilograms: List<Float>
  
  weightIncrementPounds: Float? = null
  weightIncrementKilograms: Float? = null
  
  targetRepetitionsInReserve: List<Int> // Reps in Reserve
  targetRatePerceivedEffort: List<Int> // Rate of Perceived Exertion

  percentage1RM: List<Float> // Percentage of 1 Rep Max

  progressionSchemeID: String? = null// TODO Determine Correct Type
  minRepetitions: Int? = null//
  maxRepetitions: Int? = null //
}

